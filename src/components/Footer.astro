---
import { site } from '../data/site';
import Contact from './Contact.astro';
---
<footer class="foot">
  <div class="row">
    <span>{site.handle} · {site.latin.split(' · ')[0]}　线稿据作者自摄照片描成</span>
    <span class="links">
      <a href={site.links.github}>GitHub</a>
      <a href={site.links.x}>X</a>
      <a href={site.links.telegram}>Telegram</a>
      <Contact />
      <a href={site.links.rss}>RSS</a>
    </span>
  </div>
</footer>
