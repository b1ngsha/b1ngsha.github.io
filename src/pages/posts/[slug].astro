---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, getSeries, neighbours, summaryOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const series = await getSeries();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, series: series.find((s) => s.id === post.data.series?.id) },
  }));
}
const { post, series } = Astro.props;
const posts = await getPosts();
const { Content, headings } = await render(post);
const { prev, next } = neighbours(posts, post);
---
<Post post={post} series={series} headings={headings} prev={prev} next={next} description={summaryOf(post, 120)}>
  <Content />
</Post>
