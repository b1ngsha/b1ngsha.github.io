---
import Base from '../../layouts/Base.astro';
import '../../styles/post.css';
---
<Base title="搜索" description="在所有文章里搜索。" current="search">
  <div class="list">
    <div class="wrap">
      <h1 class="page-title">搜索</h1>
      <form class="search-box" role="search" onsubmit="return false">
        <label class="sr-only" for="q">搜索文章</label>
        <input id="q" type="search" placeholder="想找什么？" autocomplete="off" autofocus />
      </form>
      <p class="search-note" id="note" aria-live="polite"></p>
      <ol class="results" id="results"></ol>
    </div>
  </div>
  <script>
    import '../../scripts/search';
  </script>
</Base>
