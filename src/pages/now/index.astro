---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import '../../styles/post.css';
import { formatDate } from '../../lib/format';

const entries = (await getCollection('now')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---
<Base title="近况" description="我最近在做什么、想什么。" current="now">
  <div class="list">
    <div class="wrap">
      <h1 class="page-title">近况 <span class="latin">Now</span></h1>
      {rendered.map(({ e, Content }) => (
        <section class="now-entry">
          <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
          {e.data.quote && <p class="big">{e.data.quote.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>}
          <div class="body"><Content /></div>
          {e.data.plans.length > 0 && (
            <>
              {e.data.plansTitle && <p class="todo-title latin">{e.data.plansTitle}</p>}
              <ul>{e.data.plans.map((p) => <li>{p}</li>)}</ul>
            </>
          )}
        </section>
      ))}
    </div>
  </div>
</Base>
