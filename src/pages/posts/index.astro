---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import '../../styles/home.css';
import '../../styles/post.css';
import { allTags, getPosts, getSeries } from '../../lib/posts';
import { tagLabel } from '../../lib/format';
import { tallySketch } from '../../art/sketches';

const posts = await getPosts();
const all = await getSeries();
const counts = all
  .map((s) => ({ id: s.id, name: s.data.name, count: posts.filter((p) => p.data.series?.id === s.id).length }))
  .filter((s) => s.count > 0)
  .sort((a, b) => b.count - a.count);
const loose = posts.filter((p) => !p.data.series).length;
const name = new Map(all.map((s) => [s.id, s.data.name]));
const tags = allTags(posts);
const byYear = new Map<string, typeof posts>();
posts.forEach((p) => {
  const y = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Shanghai', year: 'numeric' }).format(p.data.date);
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
});
---
<Base title="Writing" description={`${posts.length} notes on infrastructure, Rust, C++ and Go, by year and by series.`} current="posts">
  <div class="list writing">
    <div class="wrap">
      <header class="w-head">
        <h1 class="page-title">Writing</h1>
        <p class="w-count">{posts.length} notes since 2024</p>
      </header>

      <section class="w-filter" aria-label="Browse by series" data-reveal>
        <ul class="w-series">
          {counts.map((s, i) => (
            <li>
              <a href={`/series/${s.id}/`}><span class="n">{s.name}</span><span class="c">{s.count}</span></a>
              <Fragment set:html={tallySketch(s.count, i)} />
            </li>
          ))}
          {loose > 0 && <li><span class="lab"><span class="n">Other</span><span class="c">{loose}</span></span><Fragment set:html={tallySketch(loose, counts.length)} /></li>}
        </ul>
        <p class="w-tags" aria-label="Browse by tag">
          {tags.map((t) => <a href={`/tags/${t.tag}/`}>{tagLabel(t.tag)}</a>)}
        </p>
      </section>

      {[...byYear].map(([year, list]) => (
        <section class="w-year">
          <h2><span>{year}</span><small>{list.length}</small></h2>
          <ol class="idx">
            {list.map((p) => <PostRow post={p} short seriesName={p.data.series ? name.get(p.data.series.id) : ''} />)}
          </ol>
        </section>
      ))}
      <p class="more"><a href="/atom.xml">RSS feed</a></p>
    </div>
  </div>
  <script>
    import '../../scripts/reveal';
  </script>
</Base>
