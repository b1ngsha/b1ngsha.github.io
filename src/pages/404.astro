---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import '../styles/home.css';
import '../styles/post.css';
---
<Base title="Page not found" noindex footer={false}>
  <div class="lost">
    <div>
      <HeroArt />
      <h1>404</h1>
      <p>This page is not here. <a href="/">Back to the home page</a>, or <a href="/search/">search</a>.</p>
    </div>
  </div>
  <script>
    import { mountHero } from '../scripts/hero';
    const art = document.getElementById('hero-art');
    if (art) mountHero(art, { lost: true });
  </script>
</Base>
