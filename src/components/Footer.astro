---
import { site } from '../data/site';
import Contact from './Contact.astro';
import Name from './Name.astro';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="row">
    <p class="who"><Name text={site.handle} /></p>
    <Contact rss />
  </div>
  <div class="row small">
    <span>© {year} <Name text={site.handle} /></span>
  </div>
</footer>
