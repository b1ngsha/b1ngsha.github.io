---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import '../../styles/post.css';
import { allTags, getPosts, getSeries } from '../../lib/posts';
import { tagLabel } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map(({ tag }) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const posts = (await getPosts()).filter((p) => p.data.tags.includes(tag));
const name = new Map((await getSeries()).map((s) => [s.id, s.data.name]));
---
<Base title={`#${tagLabel(tag)}`} description={`带 ${tagLabel(tag)} 标签的 ${posts.length} 篇文章。`} current="posts">
  <div class="list">
    <div class="wrap">
      <h1 class="page-title">#{tagLabel(tag)} <small>{posts.length} 篇</small></h1>
      <ol class="idx">
        {posts.map((p) => <PostRow post={p} seriesName={p.data.series ? name.get(p.data.series.id) : ''} />)}
      </ol>
      <p class="chips"><a href="/tags/">所有标签</a><a href="/posts/">全部文章</a></p>
    </div>
  </div>
</Base>
