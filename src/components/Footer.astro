---
import { site } from '../data/site';
import Contact from './Contact.astro';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="row">
    <p class="who">{site.handle}</p>
    <Contact rss />
  </div>
  <div class="row small">
    <span>© {year} {site.handle}</span>
    <a class="top-link" href="#main">Back to top <svg class="arrow up" viewBox="0 0 16 28" aria-hidden="true"><path d="M8 26 C9 18 7 10 8 2 M2 8 L8 2 L14 8" /></svg></a>
  </div>
</footer>
